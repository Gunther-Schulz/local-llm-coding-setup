          "type": "text",
          "text": "     1|\"\"\"Context management: summarization + sliding window + condense large tool responses.\n     2|\n     3|Cursor (docs/blog) does two things we align with and one we cannot:\n     4|- Summarization when context fills: Cursor auto-summarizes and gives the agent chat history\n     5|  as a file so it can search for lost details. We summarize old messages and keep a sliding\n     6|  window of recent ones; we do not expose history-as-file (proxy has no client filesystem).\n     7|- Long tool responses: Cursor writes them to a file and lets the agent Read/tail on demand,\n     8|  avoiding truncation. We cannot write to the client FS, so we condense to a preview\n     9|  (TOOL_RESPONSE_MAX_VERBATIM / TOOL_RESPONSE_PREVIEW_CHARS). Optional future: proxy could\n    10|  store full results by tool_call_id and expose GET /v1/tool-results/{id} for clients that\n    11|  add a \"fetch full result\" tool.\n    12|  Instruction docs (e.g. CLIPPY_MKII.md) and code files (e.g. proxy/*.py) can be excluded via\n    13|  TOOL_RESPONSE_NO_CONDENSE_PATHS so the model sees full content in one Read instead of a short\n    14|  preview and many follow-up Reads.\n    15|\"\"\"\n    16|from typing import List, Dict, Any, Optional\n    17|import fnmatch\n    18|import json\n    19|import os\n    20|import time\n    21|import httpx\n    22|\n    23|from stack.settings import (\n    24|    DEBUG,\n    25|    BACKEND_URL,\n    26|    TOOL_RESPONSE_MAX_VERBATIM,\n    27|    TOOL_RESPONSE_PREVIEW_CHARS,\n    28|    TOOL_RESPONSE_NO_CONDENSE_PATHS,\n    29|    PRESERVE_FIRST_USER_IN_SUMMARY,\n    30|)\n    31|\n    32|\n    33|# Store old conversation history for retrieval\n    34|_conversation_archives: Dict[str, List[Dict]] = {}\n    35|\n    36|\n    37|async def summarize_conversation(messages: List[Dict]) -> str:\n    38|    \"\"\"Use the LLM to summarize old conversation context.\"\"\"\n    39|    # Build summarization prompt\n    40|    conversation_text = \"\\n\\n\".join([\n    41|        f\"{msg.get('role', 'user')}: {_extract_content_preview(msg)}\"\n    42|        for msg in messages\n    43|    ])\n    44|    \n    45|    summary_prompt = f\"\"\"Summarize this conversation history in 2-3 concise paragraphs. Focus on:\n    46|- What the user is working on\n    47|- Key decisions made\n    48|- Current state and goals\n    49|- Important context that should be remembered\n    50|\n    51|Conversation:\n    52|{conversation_text}\n    53|\n    54|Summary:\"\"\"\n    55|\n    56|    try:\n    57|        async with httpx.AsyncClient(timeout=30.0) as client:\n    58|            response = await client.post(\n    59|                f\"{BACKEND_URL}/v1/chat/completions\",\n    60|                json={\n    61|                    \"model\": \"qwen3-30b-q2\",\n    62|                    \"messages\": [{\"role\": \"user\", \"content\": summary_prompt}],\n    63|                    \"max_tokens\": 512,\n    64|                    \"temperature\": 0.3\n    65|                }\n    66|            )\n    67|            response.raise_for_status()\n    68|            result = response.json()\n    69|            return result[\"choices\"][0][\"message\"][\"content\"]\n    70|    except Exception as e:\n    71|        if DEBUG:\n    72|            print(f\"[WARNING] Summarization failed: {e}, using fallback\")\n    73|        return f\"[Previous conversation with {len(messages)} messages about code work]\"\n    74|\n    75|\n    76|def _extract_content_preview(msg: Dict, max_chars: int = 200) -> str:\n    77|    \"\"\"Extract preview of message content.\"\"\"\n    78|    content = msg.get(\"content\", \"\")\n    79|    \n    80|    if isinstance(content, str):\n    81|        text = content\n    82|    elif isinstance(content, list):\n    83|        text_parts = []\n    84|        for item in content:\n    85|            if isinstance(item, dict) and item.get(\"type\") == \"text\":\n    86|                text_parts.append(item.get(\"text\", \"\"))\n    87|        text = \" \".join(text_parts)\n    88|    else:\n    89|        text = str(content)\n    90|    \n    91|    if len(text) > max_chars:\n    92|        return text[:max_chars] + \"...\"\n    93|    return text\n    94|\n    95|\n    96|def _build_tool_call_id_to_path(messages: List[Dict]) -> Dict[str, str]:\n    97|    \"\"\"Build map tool_call_id -> file path from assistant messages' tool_calls.\"\"\"\n    98|    id_to_path: Dict[str, str] = {}\n    99|    for msg in messages:\n   100|        if msg.get(\"role\") != \"assistant\" or not msg.get(\"tool_calls\"):\n   101|            continue\n   102|        for tc in msg[\"tool_calls\"]:\n   103|            tid = tc.get(\"id\")\n   104|            if not tid:\n   105|                continue\n   106|            fn = tc.get(\"function\")\n   107|            if not isinstance(fn, dict):\n   108|                continue\n   109|            args = fn.get(\"arguments\")\n   110|            if not args:\n   111|                continue\n   112|            if isinstance(args, str):\n   113|                try:\n   114|                    args = json.loads(args)\n   115|                except json.JSONDecodeError:\n   116|                    continue\n   117|            if not isinstance(args, dict):\n   118|                continue\n   119|            path = args.get(\"path\") or args.get(\"file_path\") or args.get(\"filename\") or args.get(\"file\")\n   120|            if path:\n   121|                id_to_path[tid] = str(path)\n   122|    return id_to_path\n   123|\n   124|\n   125|def _path_matches_no_condense(path: str, patterns: List[str]) -> bool:\n   126|    \"\"\"True if path (or its basename) matches any fnmatch pattern in patterns.\"\"\"\n   127|    base = os.path.basename(path)\n   128|    for p in patterns:\n   129|        if fnmatch.fnmatch(path, p) or fnmatch.fnmatch(base, p):\n   130|            return True\n   131|    return False\n   132|\n   133|\n   134|def condense_large_tool_response(msg: Dict, skip_condense: bool = False) -> Dict:\n   135|    \"\"\"Condense large tool responses - show preview, keep full text retrievable.\n   136|    If skip_condense is True (e.g. instruction doc), return msg unchanged.\"\"\"\n   137|    if msg.get(\"role\") != \"tool\":\n   138|        return msg\n   139|    if skip_condense:\n   140|        return msg\n   141|\n   142|    content = msg.get(\"content\", \"\")\n   143|    if isinstance(content, list) and len(content) > 0:\n   144|        text_content = content[0].get(\"text\", \"\") if isinstance(content[0], dict) else str(content[0])\n   145|    else:\n   146|        text_content = str(content)\n   147|\n   148|    # If tool response is large, condense to preview only\n   149|    if len(text_content) > TOOL_RESPONSE_MAX_VERBATIM:\n   150|        preview = text_content[:TOOL_RESPONSE_PREVIEW_CHARS] + f\"\\n\\n[... {len(text_content) - TOOL_RESPONSE_PREVIEW_CHARS} more characters omitted ...]\"\n   151|\n   152|        condensed = msg.copy()\n   153|        if isinstance(content, list):\n   154|            condensed[\"content\"] = [{\"type\": \"text\", \"text\": preview}]\n   155|        else:\n   156|            condensed[\"content\"] = preview\n   157|\n   158|        condensed[\"_full_content_length\"] = len(text_content)\n   159|        return condensed\n   160|\n   161|    return msg\n   162|\n   163|\n   164|def condense_tool_responses_with_context(\n   165|    messages: List[Dict],\n   166|    no_condense_patterns: Optional[List[str]] = None,\n   167|) -> List[Dict]:\n   168|    \"\"\"Condense large tool responses, but skip condensing for paths matching no_condense_patterns\n   169|    (e.g. instruction docs like CLIPPY_MKII.md). Patterns use fnmatch (*CLIPPY*.md).\"\"\"\n   170|    if no_condense_patterns is None:\n   171|        no_condense_patterns = TOOL_RESPONSE_NO_CONDENSE_PATHS\n   172|    id_to_path = _build_tool_call_id_to_path(messages)\n   173|    result = []\n   174|    for msg in messages:\n   175|        if msg.get(\"role\") != \"tool\":\n   176|            result.append(msg)\n   177|            continue\n   178|        tid = msg.get(\"tool_call_id\")\n   179|        path = id_to_path.get(tid) if tid else None\n   180|        skip = bool(path and _path_matches_no_condense(path, no_condense_patterns))\n   181|        if DEBUG and skip:\n   182|            print(f\"[DEBUG] No condense for tool result (path matches): {path}\")\n   183|        result.append(condense_large_tool_response(msg, skip_condense=skip))\n   184|    return result\n   185|\n   186|\n   187|async def manage_context(\n   188|    messages: List[Dict],\n   189|    conversation_id: str,\n   190|    max_messages: int = 20\n   191|) -> List[Dict]:\n   192|    \"\"\"\n   193|    When conversation is large (message or token threshold): keep last N messages\n   194|    (sliding window), summarize older ones into one user message, condense large\n   195|    tool responses in the kept window. Archives old messages in memory per\n   196|    conversation_id (for possible future retrieval).\n   197|    \"\"\"\n   198|    if len(messages) <= max_messages:\n   199|        # Small conversation, no management needed\n   200|        return messages\n   201|    \n   202|    # Separate system prompt from conversation\n   203|    system_prompt = None\n   204|    conversation_messages = messages\n   205|    \n   206|    if messages and messages[0].get(\"role\") == \"system\":\n   207|        system_prompt = messages[0]\n   208|        conversation_messages = messages[1:]\n   209|    \n   210|    # Split: old messages to summarize vs recent to keep\n   211|    split_point = len(conversation_messages) - max_messages\n   212|    old_messages = conversation_messages[:split_point]\n   213|    recent_messages = conversation_messages[split_point:]\n   214|    \n   215|    if DEBUG:\n   216|        print(f\"[DEBUG] Context management: {len(old_messages)} old, {len(recent_messages)} recent\")\n   217|    \n   218|    # Archive old messages for retrieval\n   219|    if conversation_id not in _conversation_archives:\n   220|        _conversation_archives[conversation_id] = []\n   221|    _conversation_archives[conversation_id].extend(old_messages)\n   222|    \n   223|    if DEBUG:\n   224|        print(f\"[DEBUG] Archived {len(old_messages)} messages (total archive: {len(_conversation_archives[conversation_id])})\")\n   225|\n   226|    # Summarize old context\n   227|    _sum_start = time.perf_counter()\n   228|    summary = await summarize_conversation(old_messages)\n   229|    if DEBUG:\n   230|        print(f\"[DEBUG] Summarization took {time.perf_counter() - _sum_start:.2f}s\")\n   231|        print(f\"[DEBUG] Generated summary: {summary[:100]}...\")\n   232|    \n   233|    # Prepend first user message so task context (e.g. \"use CLIPPY\") stays in context\n   234|    summary_parts = []\n   235|    if PRESERVE_FIRST_USER_IN_SUMMARY:\n   236|        first_user = next((m for m in old_messages if m.get(\"role\") == \"user\"), None)\n   237|        if first_user:\n   238|            first_content = _extract_content_preview(first_user, max_chars=2000)\n   239|            summary_parts.append(f\"[Initial user request]:\\n{first_content}\\n\")\n   240|    summary_parts.append(f\"[Previous conversation summary]:\\n{summary}\\n\\n[Continuing conversation...]\")\n   241|    summary_content = \"\\n\".join(summary_parts)\n   242|\n   243|    summary_message = {\n   244|        \"role\": \"user\",\n   245|        \"content\": summary_content\n   246|    }\n   247|\n   248|    # Condense large tool responses in recent messages (instruction docs bypassed via patterns)\n   249|    condensed_recent = condense_tool_responses_with_context(recent_messages)\n   250|    \n   251|    # Build final context\n   252|    final_messages = []\n   253|    if system_prompt:\n   254|        final_messages.append(system_prompt)\n   255|    final_messages.append(summary_message)\n   256|    final_messages.extend(condensed_recent)\n   257|    \n   258|    if DEBUG:\n   259|        print(f\"[DEBUG] Final context: {len(final_messages)} messages (1 summary + {len(condensed_recent)} recent)\")\n   260|    \n   261|    return final_messages\n   262|"
