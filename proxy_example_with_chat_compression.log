          "text": "... 91 lines not shown ...\n    92|@app.post(\"/v1/chat/completions\")\n    93|async def chat_completions_v1(request: Request):\n    94|    \"\"\"Handle chat completions with compression, vision routing, and tool transformation.\"\"\"\n    95|    request_id = request.headers.get(\"x-request-id\") or f\"req-{uuid.uuid4().hex[:12]}\"\n    96|    try:\n    97|        # Get raw body\n    98|        raw_body = await request.body()\n    99|        body_json = json.loads(raw_body)\n   100|        \n   101|        # Log request (include request_id for correlation with Cursor / backend logs)\n   102|        client_ip = request.client.host if request.client else 'unknown'\n   103|        print(f\"[INFO] Request {request_id} from {client_ip} - model: {body_json.get('model', 'N/A')}, \"\n   104|              f\"messages: {len(body_json.get('messages', []))}, tools: {'tools' in body_json}\")\n   105|        \n   106|        if DEBUG:\n   107|            print(f\"[DEBUG] Full request:\\n{json.dumps(body_json, indent=2)}\")\n   108|        \n   109|        # Parse request\n   110|        chat_request = ChatCompletionRequest(**body_json)\n   111|        result = await handle_chat_completions(chat_request, request_id=request_id)\n   112|        \n   113|        if DEBUG and isinstance(result, dict):\n   114|            print(f\"[DEBUG] Response:\\n{json.dumps(result, indent=2)}\")\n   115|        \n   116|        return result\n   117|    \n   118|    except HTTPException:\n   119|        raise  # Preserve 413, 502, 503 etc. \u2013 do not turn into 500\n   120|    except Exception as e:\n   121|        print(f\"[ERROR] Request {request_id} failed: {e}\")\n   122|        print(f\"[ERROR] {traceback.format_exc()}\")\n   123|        raise HTTPException(status_code=500, detail=str(e))\n   124|\n   125|\n   126|async def handle_chat_completions(request: ChatCompletionRequest, request_id: Optional[str] = None):\n   127|    \"\"\"Main handler for chat completions.\"\"\"\n   128|    _t0 = time.perf_counter()\n   129|    # Convert to dicts, preserving tool_calls and tool_call_id for multi-turn tool use\n   130|    incoming_messages = []\n   131|    for msg in request.messages:\n   132|        msg_dict = msg.model_dump()\n   133|        # Keep all fields; only drop explicit None for optional content (use \"\" for backend)\n   134|        if msg_dict.get(\"content\") is None:\n   135|            msg_dict[\"content\"] = \"\"\n   136|        msg_dict = {k: v for k, v in msg_dict.items() if v is not None}\n   137|        incoming_messages.append(msg_dict)\n   138|    if DEBUG and any(m.get(\"tool_calls\") or m.get(\"tool_call_id\") for m in incoming_messages):\n   139|        print(f\"[DEBUG] Request has tool context: {sum(1 for m in incoming_messages if m.get('tool_calls'))} assistant tool_calls, \"\n   140|              f\"{sum(1 for m in incoming_messages if m.get('tool_call_id'))} tool result(s)\")\n   141|    \n   142|    # Check for images and process with vision API if present\n   143|    if vision_service.has_image_content(incoming_messages):\n   144|        if DEBUG:\n   145|            print(\"[DEBUG] Image detected, routing to vision API\")\n   146|        _t_vision = time.perf_counter()\n   147|\n   148|        has_imgs, text_msgs, image_msgs = vision_service.extract_images_and_text(incoming_messages)\n   149|\n   150|        # Query vision API for image description (this call can take 10s\u20132min; timeout 120s)\n   151|        vision_result = await vision_service.query_vision_api(image_msgs, max_tokens=512)\n   152|        if DEBUG:\n   153|            print(f\"[DEBUG] Vision API took {round((time.perf_counter() - _t_vision) * 1000)} ms\")\n   154|        \n   155|        # Check if vision API returned an error\n   156|        if \"error\" in vision_result:\n   157|            error_info = vision_result[\"error\"]\n   158|            raise HTTPException(\n   159|                status_code=503,\n   160|                detail=error_info.get(\"message\", \"Vision API unavailable\")\n   161|            )\n   162|        \n   163|        # Extract vision response content\n   164|        vision_content = \"\"\n   165|        if \"choices\" in vision_result and len(vision_result[\"choices\"]) > 0:\n   166|            vision_content = vision_result[\"choices\"][0].get(\"message\", {}).get(\"content\", \"\")\n   167|        \n   168|        if DEBUG:\n   169|            print(f\"[DEBUG] Vision description: {vision_content[:200]}...\")\n   170|        \n   171|        # Replace images with vision descriptions for LLM\n   172|        # We'll use the original function since it's not in the service\n   173|        from proxy.vision_router import prepare_multimodal_request\n   174|        incoming_messages = prepare_multimodal_request(text_msgs, image_msgs, vision_content)\n   175|    else:\n   176|        # No images - normalize multimodal text content\n   177|        for i, msg in enumerate(incoming_messages):\n   178|            if isinstance(msg.get(\"content\"), list):\n   179|                text_parts = []\n   180|                for item in msg[\"content\"]:\n   181|                    if isinstance(item, dict) and item.get(\"type\") in (\"text\", \"input_text\"):\n   182|                        text_parts.append(item.get(\"text\", \"\"))\n   183|                incoming_messages[i][\"content\"] = \" \".join(text_parts)\n   184|    \n   185|    # Condense + sliding window only when COMPRESSION_ENABLED\n   186|    tokens_before_condense = total_tokens(incoming_messages, request.tools)\n   187|    BACKEND_CTX_LIMIT = get_effective_context_limit()\n   188|    if COMPRESSION_ENABLED:\n   189|        near_limit_threshold = int(BACKEND_CTX_LIMIT * COMPRESSION_NEAR_LIMIT_FRACTION)\n   190|        skip_condense = (\n   191|            COMPRESSION_ONLY_WHEN_NEAR_LIMIT\n   192|            and tokens_before_condense <= near_limit_threshold\n   193|        )\n   194|        if not skip_condense:\n   195|            incoming_messages = context_service.condense_tool_responses_with_context(incoming_messages)\n   196|        elif DEBUG:\n   197|            print(f\"[DEBUG] No tool condense (under {near_limit_threshold} tokens, near_limit mode)\")\n   198|    else:\n   199|        if DEBUG:\n   200|            print(f\"[DEBUG] Compression disabled, pass-through\")\n   201|    tool_responses_condensed = sum(1 for m in incoming_messages if m.get(\"_full_content_length\") is not None)\n   202|    tokens_after_condense = total_tokens(incoming_messages, request.tools)\n   203|    prompt_tokens = tokens_after_condense\n   204|\n   205|    conversation_id = get_conversation_id(incoming_messages)\n   206|    final_messages = incoming_messages\n   207|    sliding_window_active = False\n   208|    trigger_reason = None\n   209|    messages_summarized = 0\n   210|    messages_kept = 0\n   211|\n   212|    sliding_trigger = False\n   213|    if COMPRESSION_ENABLED:\n   214|        sliding_trigger = (\n   215|            prompt_tokens > COMPRESSION_THRESHOLD\n   216|            if COMPRESSION_ONLY_WHEN_NEAR_LIMIT\n   217|            else prompt_tokens > COMPRESSION_THRESHOLD\n   218|        )\n   219|    if sliding_trigger:\n   220|        sliding_window_active = True\n   221|        if COMPRESSION_ONLY_WHEN_NEAR_LIMIT:\n   222|            trigger_reason = f\"tokens>{COMPRESSION_THRESHOLD} (near_limit mode)\"\n   223|        elif len(incoming_messages) > COMPRESSION_TRIGGER_MESSAGES and prompt_tokens > COMPRESSION_THRESHOLD:\n   224|            trigger_reason = f\"messages>{COMPRESSION_TRIGGER_MESSAGES} and tokens>{COMPRESSION_THRESHOLD}\"\n   225|        elif len(incoming_messages) > COMPRESSION_TRIGGER_MESSAGES:\n   226|            trigger_reason = f\"messages>{COMPRESSION_TRIGGER_MESSAGES}\"\n   227|        else:\n   228|            trigger_reason = f\"tokens>{COMPRESSION_THRESHOLD}\"\n   229|        conv_count = len(incoming_messages) - (1 if incoming_messages and incoming_messages[0].get(\"role\") == \"system\" else 0)\n   230|        messages_summarized = max(0, conv_count - CONTEXT_WINDOW_SIZE)\n   231|        messages_kept = CONTEXT_WINDOW_SIZE\n   232|\n   233|        final_messages = await context_service.manage_context(\n   234|            incoming_messages,\n   235|            conversation_id,\n   236|            max_messages=CONTEXT_WINDOW_SIZE\n   237|        )\n   238|        prompt_tokens = total_tokens(final_messages, request.tools)\n   239|\n   240|    max_completion_allowed = max(1, BACKEND_CTX_LIMIT - SAFETY_MARGIN - prompt_tokens)\n   241|\n   242|    # Use client max_tokens if set; otherwise allow full completion up to backend capacity (no artificial cap)\n   243|    requested = request.max_tokens or request.max_completion_tokens\n   244|    if requested and requested > max_completion_allowed:\n   245|        if DEBUG:\n   246|            print(f\"[DEBUG] Requested {requested} tokens, but only {max_completion_allowed} available - capping\")\n   247|        requested = max_completion_allowed\n   248|    effective_max_tokens = requested if requested else max_completion_allowed\n   249|    MIN_MAX_TOKENS = 64\n   250|    if effective_max_tokens < MIN_MAX_TOKENS:\n   251|        if max_completion_allowed < MIN_MAX_TOKENS:\n   252|            if DEBUG:\n   253|                print(f\"[DEBUG] Rejecting: prompt too long ({prompt_tokens} > {BACKEND_CTX_LIMIT})\")\n   254|            raise HTTPException(\n   255|                status_code=413,\n   256|                detail=f\"Prompt too long: {prompt_tokens} tokens exceeds backend context ({BACKEND_CTX_LIMIT}). \"\n   257|                \"Shorten the conversation or use fewer tool results.\"\n   258|            )\n   259|        effective_max_tokens = min(MIN_MAX_TOKENS, max_completion_allowed)\n   260|\n   261|    if DEBUG:\n   262|        elapsed_ms = round((time.perf_counter() - _t0) * 1000)\n   263|        conv_id_short = (conversation_id[:12] + \"..\") if len(conversation_id) > 12 else conversation_id\n   264|        rid = request_id or \"n/a\"\n   265|        print(f\"[DEBUG] ---- context (request_id: {rid}) ----\")\n   266|        print(f\"[DEBUG]   stream: {bool(request.stream)}, conversation_id: {conv_id_short}, elapsed_ms: {elapsed_ms}\")\n   267|        print(f\"[DEBUG]   messages_in: {len(incoming_messages)}, tokens_in: {tokens_before_condense}\")\n   268|        print(f\"[DEBUG]   tool_condense: {tool_responses_condensed} response(s) condensed, tokens_after_condense: {tokens_after_condense}\")\n   269|        if sliding_window_active:\n   270|            print(f\"[DEBUG]   sliding_window: yes (trigger: {trigger_reason})\")\n   271|            print(f\"[DEBUG]   window_size: {CONTEXT_WINDOW_SIZE}, messages_summarized: {messages_summarized}, messages_kept: {messages_kept}\")\n   272|            print(f\"[DEBUG]   messages_out: {len(final_messages)}, tokens_out: {prompt_tokens}\")\n   273|        else:\n   274|            print(f\"[DEBUG]   sliding_window: no\")\n   275|            print(f\"[DEBUG]   messages_out: {len(final_messages)}, tokens_out: {prompt_tokens}\")\n   276|        print(f\"[DEBUG]   context_limit: {BACKEND_CTX_LIMIT}, max_completion_available: {max_completion_allowed}, max_tokens_sent: {effective_max_tokens}\")\n   277|        print(\"[DEBUG] --------------------------\")\n   278|\n   279|    # Clean messages: ensure only valid fields; match backend expectations for tool turns\n   280|    cleaned_messages = []\n   281|    for msg in final_messages:\n   282|        role = msg.get(\"role\")\n   283|        content = msg.get(\"content\", \"\")\n   284|        cleaned = {\"role\": role}\n   285|        # Assistant with only tool_calls: omit content so backend sees tool turn (llama-server can mis-handle content: \"\")\n   286|        if role == \"assistant\" and msg.get(\"tool_calls\") and (content is None or content == \"\"):\n   287|            pass  # no content key\n   288|        else:\n   289|            cleaned[\"content\"] = content if content is not None else \"\"\n   290|        if msg.get(\"tool_calls\"):\n   291|            cleaned[\"tool_calls\"] = msg[\"tool_calls\"]\n... 107 lines not shown ..."
