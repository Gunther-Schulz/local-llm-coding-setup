          "type": "text",
          "text": "     1|\"\"\"Tool call parsing and transformation for Qwen models.\"\"\"\n     2|import json\n     3|import os\n     4|import re\n     5|import uuid\n     6|from typing import List, Dict, Optional\n     7|\n     8|from stack.settings import DEBUG\n     9|\n    10|\n    11|def _extract_braced_json(s: str, start: int) -> tuple[Optional[str], int]:\n    12|    \"\"\"Extract a single {...} JSON object from s starting at start; return (json_str, end_pos).\"\"\"\n    13|    i = s.find(\"{\", start)\n    14|    if i < 0:\n    15|        return None, start\n    16|    depth = 0\n    17|    j = i\n    18|    while j < len(s):\n    19|        if s[j] == \"{\":\n    20|            depth += 1\n    21|        elif s[j] == \"}\":\n    22|            depth -= 1\n    23|            if depth == 0:\n    24|                return s[i : j + 1], j + 1\n    25|        elif s[j] == '\"' and (j == 0 or s[j - 1] != \"\\\\\"):\n    26|            j += 1\n    27|            while j < len(s) and (s[j] != '\"' or s[j - 1] == \"\\\\\"):\n    28|                j += 1\n    29|        j += 1\n    30|    return None, start\n    31|\n    32|\n    33|def _make_tool_call(name: str, arguments: dict) -> Dict:\n    34|    \"\"\"Build OpenAI-compatible tool call dict.\"\"\"\n    35|    return {\n    36|        \"id\": f\"call_{uuid.uuid4().hex[:24]}\",\n    37|        \"type\": \"function\",\n    38|        \"function\": {\n    39|            \"name\": name,\n    40|            \"arguments\": json.dumps(arguments) if isinstance(arguments, dict) else json.dumps({})\n    41|        }\n    42|    }\n    43|\n    44|\n    45|def parse_qwen_tool_calls(content: str) -> Optional[List[Dict]]:\n    46|    \"\"\"\n    47|    Parse tool calls from XML or JSON format.\n    48|    \n    49|    Formats supported:\n    50|    1. Cursor-style: <read><file>path</file></read>, <function=Read><file>path</file></function>\n    51|    2. Qwen XML: <function>{\"name\":\"...\", \"arguments\":{...}}</function>\n    52|    3. Markdown: ```json\\n{\"name\":\"...\", \"arguments\":{...}}\\n```\n    53|    \n    54|    Returns OpenAI-compatible tool_calls array.\n    55|    \"\"\"\n    56|    tool_calls = []\n    57|    seen: set = set()  # (name, args_str) to avoid duplicates\n    58|\n    59|    # Cursor-style: <read><file>path</file></read> or <tool_name><file>path</file></tool_name>\n    60|    for m in re.finditer(r\"<(\\w+)>\\s*<file>(.*?)</file>\\s*</\\1>\", content, re.DOTALL | re.IGNORECASE):\n    61|        tool_name = m.group(1).strip()\n    62|        path = m.group(2).strip()\n    63|        if not path or not tool_name:\n    64|            continue\n    65|        name = tool_name[0].upper() + tool_name[1:].lower() if tool_name else \"\"\n    66|        key = (name, path)\n    67|        if key not in seen:\n    68|            seen.add(key)\n    69|            tool_calls.append(_make_tool_call(name, {\"path\": path}))\n    70|\n    71|    # <function=Read> or <function name=\"Read\"> with <file>path</file> inside\n    72|    for m in re.finditer(r\"<function\\s*=?\\s*(\\w+)>(.*?)</function>\", content, re.DOTALL | re.IGNORECASE):\n    73|        name = m.group(1).strip()\n    74|        if not name:\n    75|            continue\n    76|        name = name[0].upper() + name[1:].lower()\n    77|        inner = m.group(2)\n    78|        file_m = re.search(r\"<file>(.*?)</file>\", inner, re.DOTALL | re.IGNORECASE)\n    79|        if file_m:\n    80|            path = file_m.group(1).strip()\n    81|            key = (name, path)\n    82|            if key not in seen:\n    83|                seen.add(key)\n    84|                tool_calls.append(_make_tool_call(name, {\"path\": path}))\n    85|\n    86|    # Qwen XML: <function>{\"name\":\"...\", \"arguments\":{...}}</function>\n    87|    for tag in (\"function\", \"tool_call\"):\n    88|        pattern = re.compile(\n    89|            rf\"<{tag}\\s*>(.*?)</{tag}>\",\n    90|            re.DOTALL,\n    91|        )\n    92|        for m in pattern.finditer(content):\n    93|            inner = m.group(1).strip()\n    94|            json_str, _ = _extract_braced_json(inner, 0)\n    95|            if not json_str:\n    96|                continue\n    97|            try:\n    98|                tool_data = json.loads(json_str)\n    99|                name = tool_data.get(\"name\", \"\")\n   100|                args = tool_data.get(\"arguments\", {})\n   101|                key = (name, json.dumps(args, sort_keys=True))\n   102|                if key not in seen:\n   103|                    seen.add(key)\n   104|                    tool_calls.append(_make_tool_call(name, args))\n   105|            except json.JSONDecodeError:\n   106|                if DEBUG:\n   107|                    print(f\"[DEBUG] Failed to parse XML tool call: {json_str[:100]}\")\n   108|    \n   109|    # Pattern 2: JSON in markdown code blocks\n   110|    for m in re.finditer(r\"```(?:json)?\\s*\\n\", content):\n   111|        json_str, end_pos = _extract_braced_json(content, m.end())\n   112|        if not json_str:\n   113|            continue\n   114|        try:\n   115|            tool_data = json.loads(json_str)\n   116|            if \"name\" in tool_data:\n   117|                name = tool_data.get(\"name\", \"\")\n   118|                args = tool_data.get(\"arguments\", {})\n   119|                key = (name, json.dumps(args, sort_keys=True))\n   120|                if key not in seen:\n   121|                    seen.add(key)\n   122|                    tool_calls.append(_make_tool_call(name, args))\n   123|        except json.JSONDecodeError:\n   124|            if DEBUG:\n   125|                print(f\"[DEBUG] Failed to parse markdown tool call: {json_str[:100]}\")\n   126|    \n   127|    return tool_calls if tool_calls else None\n   128|\n   129|\n   130|def should_transform_tool_calls(vllm_sent: bool) -> bool:\n   131|    \"\"\"Check if we should transform tool calls based on model and vLLM behavior.\n   132|    Reads MODEL_TOOL_FORMAT at call time so proxy launcher's env is respected.\"\"\"\n   133|    if vllm_sent:\n   134|        return False  # vLLM already handled it\n   135|    \n   136|    fmt = os.getenv(\"MODEL_TOOL_FORMAT\", \"openai\")\n   137|    return fmt in (\"qwen2.5\", \"qwen3\", \"auto\")\n   138|\n   139|\n   140|def transform_qwen_response(response_data: Dict) -> Dict:\n   141|    \"\"\"Transform non-streaming Qwen response to extract tool calls.\"\"\"\n   142|    if not isinstance(response_data, dict):\n   143|        return response_data\n   144|    \n   145|    choices = response_data.get(\"choices\", [])\n   146|    for choice in choices:\n   147|        message = choice.get(\"message\", {})\n   148|        content = message.get(\"content\", \"\")\n   149|        \n   150|        # Only transform if no tool_calls and content has tool calls\n   151|        if not message.get(\"tool_calls\") and isinstance(content, str):\n   152|            tool_calls = parse_qwen_tool_calls(content)\n   153|            \n   154|            if tool_calls:\n   155|                if DEBUG:\n   156|                    print(f\"[DEBUG] Extracted {len(tool_calls)} tool call(s) from response\")\n   157|                \n   158|                message[\"tool_calls\"] = tool_calls\n   159|                message[\"content\"] = None\n   160|                choice[\"finish_reason\"] = \"tool_calls\"\n   161|    \n   162|    return response_data\n   163|\n   164|\n   165|def generate_tool_call_chunks(tool_calls: List[Dict], chunk_id: str, model_name: str, created_time: int):\n   166|    \"\"\"Generate SSE chunks for tool calls in OpenAI format.\"\"\"\n   167|    # Send each tool call as delta\n   168|    for i, tool_call in enumerate(tool_calls):\n   169|        tool_chunk = {\n   170|            \"id\": chunk_id,\n   171|            \"object\": \"chat.completion.chunk\",\n   172|            \"created\": created_time,\n   173|            \"model\": model_name,\n   174|            \"choices\": [{\n   175|                \"index\": 0,\n   176|                \"delta\": {\n   177|                    \"tool_calls\": [{\n   178|                        \"index\": i,\n   179|                        \"id\": tool_call[\"id\"],\n   180|                        \"type\": \"function\",\n   181|                        \"function\": {\n   182|                            \"name\": tool_call[\"function\"][\"name\"],\n   183|                            \"arguments\": tool_call[\"function\"][\"arguments\"]\n   184|                        }\n   185|                    }]\n   186|                },\n   187|                \"finish_reason\": None\n   188|            }]\n   189|        }\n   190|        yield f\"data: {json.dumps(tool_chunk)}\\n\\n\"\n   191|    \n   192|    # Send final chunk with finish_reason\n   193|    final_chunk = {\n   194|        \"id\": chunk_id,\n   195|        \"object\": \"chat.completion.chunk\",\n   196|        \"created\": created_time,\n   197|        \"model\": model_name,\n   198|        \"choices\": [{\n   199|            \"index\": 0,\n   200|            \"delta\": {},\n   201|            \"finish_reason\": \"tool_calls\"\n   202|        }]\n   203|    }\n   204|    yield f\"data: {json.dumps(final_chunk)}\\n\\n\"\n   205|"
        }
      ]
