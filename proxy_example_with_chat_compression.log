=========\n    52|\n    53|VLLM_HOST = os.getenv(\"VLLM_HOST\", \"0.0.0.0\")\n    54|VLLM_PORT = int(os.getenv(\"VLLM_PORT\", \"8000\"))\n    55|VLLM_URL = os.getenv(\"VLLM_URL\", f\"http://localhost:{VLLM_PORT}\")\n    56|\n    57|# LLM backend URL (vLLM or llama-server); proxy and clients use this\n    58|BACKEND_URL = os.getenv(\"BACKEND_URL\", f\"http://localhost:{VLLM_PORT}\")\n    59|\n    60|PROXY_HOST = os.getenv(\"PROXY_HOST\", \"0.0.0.0\")\n    61|PROXY_PORT = int(os.getenv(\"PROXY_PORT\", \"8002\"))\n    62|\n    63|VISION_HOST = os.getenv(\"VISION_HOST\", \"0.0.0.0\")\n    64|VISION_PORT = int(os.getenv(\"VISION_PORT\", \"8004\"))\n    65|VISION_URL = os.getenv(\"VISION_API_URL\", f\"http://localhost:{VISION_PORT}\")\n    66|\n    67|\n    68|# ============================================================================\n    69|# vLLM Configuration\n    70|# ============================================================================\n    71|\n    72|VLLM_DTYPE = os.getenv(\"VLLM_DTYPE\", \"float16\")\n    73|VLLM_CPU_OFFLOAD_GB = os.getenv(\"VLLM_CPU_OFFLOAD_GB\", \"8\")\n    74|VLLM_TENSOR_PARALLEL = int(os.getenv(\"VLLM_TENSOR_PARALLEL\", \"1\"))\n    75|\n    76|# CUDA graph mode: \"PIECEWISE\" (safe on 5090+AMD) or \"FULL\" (may crash)\n    77|VLLM_CUDAGRAPH_MODE = os.getenv(\"VLLM_CUDAGRAPH_MODE\", \"PIECEWISE\")\n    78|\n    79|\n    80|# ============================================================================\n    81|# Context and Token Management\n    82|# ============================================================================\n    83|\n    84|# Model context limits (set by model config, can override)\n    85|MODEL_MAX_CONTEXT = int(os.getenv(\"MODEL_MAX_CONTEXT\", \"32768\"))\n    86|MODEL_EXTENDED_CONTEXT = os.getenv(\"MODEL_EXTENDED_CONTEXT\")  # Optional extended context\n    87|\n    88|# Prompt limits\n    89|MAX_PROMPT_TOKENS = int(os.getenv(\"MAX_PROMPT_TOKENS\", \"30000\"))  # Max prompt size\n    90|SAFETY_MARGIN = int(os.getenv(\"SAFETY_MARGIN\", \"1536\"))  # Reserve for response\n    91|\n    92|\n    93|# ============================================================================\n    94|# Compression Settings (proxy feature toggles: config/settings.env \"Proxy feature toggles\")\n    95|# ============================================================================\n    96|# When 0: no tool condense, no sliding window; requests pass through until backend hits its limit (e.g. 413).\n    97|COMPRESSION_ENABLED = os.getenv(\"COMPRESSION_ENABLED\", \"1\") == \"1\"\n    98|\n    99|# Context management (Cursor-style: summarization + sliding window)\n   100|COMPRESSION_THRESHOLD = int(os.getenv(\"COMPRESSION_THRESHOLD\", \"15000\"))  # Trigger summarization when prompt tokens exceed this\n   101|COMPRESSION_TRIGGER_MESSAGES = int(os.getenv(\"COMPRESSION_TRIGGER_MESSAGES\", \"30\"))  # Or when message count exceeds this\n   102|CONTEXT_WINDOW_SIZE = int(os.getenv(\"CONTEXT_WINDOW_SIZE\", \"20\"))  # Keep this many recent messages verbatim\n   103|MAX_ARCHIVE_MESSAGES = int(os.getenv(\"MAX_ARCHIVE_MESSAGES\", \"200\"))  # Max messages to keep in archive per conversation\n   104|# Tool response condensing (messages with role=tool longer than this get preview only)\n   105|TOOL_RESPONSE_MAX_VERBATIM = int(os.getenv(\"TOOL_RESPONSE_MAX_VERBATIM\", \"2000\"))\n   106|TOOL_RESPONSE_PREVIEW_CHARS = int(os.getenv(\"TOOL_RESPONSE_PREVIEW_CHARS\", \"500\"))\n   107|# Comma-separated path patterns for which tool responses are never condensed (fnmatch).\n   108|# Set in config/settings.env; empty = condense all large tool responses.\n   109|_TOOL_NO_CONDENSE = os.getenv(\"TOOL_RESPONSE_NO_CONDENSE_PATHS\", \"\")\n   110|TOOL_RESPONSE_NO_CONDENSE_PATHS = [p.strip() for p in _TOOL_NO_CONDENSE.split(\",\") if p.strip()]\n   111|# When sliding window is active, prepend the first user message to the summary so task context is kept\n   112|PRESERVE_FIRST_USER_IN_SUMMARY = os.getenv(\"PRESERVE_FIRST_USER_IN_SUMMARY\", \"1\") == \"1\"\n   113|# When 1: only condense tool responses and trigger sliding window when prompt is near context limit\n   114|# (tokens > context_limit * 0.85). Avoids compressing when Cursor traffic would fit in 128k anyway.\n   115|COMPRESSION_ONLY_WHEN_NEAR_LIMIT = os.getenv(\"COMPRESSION_ONLY_WHEN_NEAR_LIMIT\", \"0\") == \"1\"\n   116|COMPRESSION_NEAR_LIMIT_FRACTION = float(os.getenv(\"COMPRESSION_NEAR_LIMIT_FRACTION\", \"0.85\"))\n   117|\n   118|\n   119|# ============================================================================\n   120|# Tool Calling\n   121|# ============================================================================\n   122|\n   123|# Tool parser format: \"openai\", \"qwen2.5\", \"qwen3\", \"auto\"\n   124|MODEL_TOOL_FORMAT = os.getenv(\"MODEL_TOOL_FORMAT\", \"openai\")\n   125|\n   126|# When 1: prepend a short capability reminder to the system message so the model uses\n   127|# conversation context and tools instead of claiming it cannot (recall history, WebSearch, edits).\n   128|INJECT_CAPABILITY_REMINDER = os.getenv(\"INJECT_CAPABILITY_REMINDER\", \"1\") == \"1\"\n   129|\n   130|_CAPABILITY_REMINDER_DEFAULT = (\n   131|    \"\\n\\n<capability_reminder>\\n\"\n   132|    \"In this session you have (1) the full conversation in the messages above\u2014use it to recall or refer to earlier messages; \"\n   133|    \"(2) the tools listed in this request\u2014use them when appropriate (e.g. WebSearch for current info, StrReplace/Write for file changes) rather than only advising. \"\n   134|    \"Do not claim you lack history or capabilities that are present in this request.\\n\"\n   135|    \"</capability_reminder>\\n\"\n   136|)\n   137|\n   138|\n   139|def _load_capability_reminder_text() -> str:\n   140|    \"\"\"Load capability reminder from config/capability_reminder.txt, or return default if missing.\"\"\"\n   141|    root = Path(__file__).resolve().parents[1]\n   142|    path = root / \"config\" / \"capability_reminder.txt\"\n   143|    try:\n   144|        if path.exists():\n   145|            text = path.read_text(encoding=\"utf-8\").strip()\n   146|            if text:\n   147|                return \"\\n\\n\" + text + \"\\n\"\n   148|    except OSError:\n   149|        pass\n   150|    return _CAPABILITY_REMINDER_DEFAULT\n   151|\n   152|\n   153|CAPABILITY_REMINDER_TEXT = _load_capability_reminder_text()\n   154|\n   155|\n   156|# ============================================================================\n   157|# Vision Configuration\n   158|# ============================================================================\n   159|\n   160|# Vision model paths (set by vision launcher from model config)\n   161|VISION_GGUF_PATH = os.getenv(\"VISION_GGUF_PATH\", \"\")\n   162|VISION_MMPROJ_PATH = os.getenv(\"VISION_MMPROJ_PATH\", \"\")\n   163|VISION_MAX_CONTEXT = int(os.getenv(\"VISION_MAX_CONTEXT\", \"32768\"))\n   164|\n   165|# llama.cpp binary path (use mtmd-cli - all specialized binaries are deprecated)\n   166|LLAMACPP_BIN = os.getenv(\"LLAMACPP_BIN\", \"./external/llama.cpp/build/bin/llama-mtmd-cli\")\n   167|\n   168|# llama-server for LLM engine (when LLM_ENGINE=llamacpp); CUDA build in external/llama.cpp/build-cuda\n   169|LLAMACPP_SERVER_BIN = os.getenv(\"LLAMACPP_SERVER_BIN\", \"./external/llama.cpp/build-cuda/bin/llama-server\")\n   170|\n   171|\n   172|# ============================================================================\n   173|# Debug and Logging\n   174|# ============================================================================\n   175|\n   176|DEBUG = os.getenv(\"DEBUG\", \"0\") == \"1\"\n   177|LOG_DIR = os.getenv(\"LOG_DIR\", \"logs\")\n   178|\n   179|\n   180|# ============================================================================\n   181|# Helper Functions\n   182|# ============================================================================\n   183|\n   184|def get_effective_context_limit() -> int:\n   185|    \"\"\"Get the effective context limit for the current model. Reads os.environ at call time\n   186|    so proxy/llm launchers that set MODEL_EXTENDED_CONTEXT after importing settings are respected.\"\"\"\n   187|    extended_ctx = os.getenv(\"MODEL_EXTENDED_CONTEXT\")\n   188|    if extended_ctx:\n   189|        return int(extended_ctx)\n   190|    return int(os.getenv(\"MODEL_MAX_CONTEXT\", str(MODEL_MAX_CONTEXT)))\n   191|\n   192|\n   193|def get_max_completion_tokens(prompt_tokens: int) -> int:\n   194|    \"\"\"Calculate maximum completion tokens given prompt size.\"\"\"\n   195|    ctx_limit = get_effective_context_limit()\n   196|    return max(1, ctx_limit - SAFETY_MARGIN - prompt_tokens)\n   197|\n   198|\n   199|def print_config_summary():\n   200|    \"\"\"Print current configuration (useful for debugging).\"\"\"\n   201|    print(\"=\" * 70)\n   202|    print(\"Configuration Summary\")\n   203|    print(\"=\" * 70)\n   204|    print(f\"Backend:     {BACKEND_URL}\")\n   205|    print(f\"vLLM:        {VLLM_URL}\")\n   206|    print(f\"Proxy:       {PROXY_HOST}:{PROXY_PORT}\")\n   207|    print(f\"Vision:      {VISION_URL}\")\n   208|    print(f\"Context:     {MODEL_MAX_CONTEXT} tokens\")\n   209|    print(f\"Max Prompt:  {MAX_PROMPT_TOKENS} tokens\")\n   210|    print(f\"Context Mgmt: Cursor-style (summarization + window)\")\n   211|    print(f\"  Threshold:    {COMPRESSION_THRESHOLD} tokens (or when messages > {COMPRESSION_TRIGGER_MESSAGES})\")\n   212|    print(f\"  Window Size:  {CONTEXT_WINDOW_SIZE} messages (keep recent verbatim)\")\n   213|    print(f\"  Max Archive:  {MAX_ARCHIVE_MESSAGES} messages\")\n   214|    print(f\"Debug:       {'On' if DEBUG else 'Off'}\")\n   215|    print(\"=\" * 70)\n   216|"
