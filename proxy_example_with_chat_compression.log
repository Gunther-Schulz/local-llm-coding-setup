          "text": "     1|\"\"\"Pydantic models for proxy requests/responses.\"\"\"\n     2|from typing import List, Dict, Any, Optional, Union, Literal\n     3|from pydantic import BaseModel, Field\n     4|\n     5|\n     6|class ChatMessage(BaseModel):\n     7|    \"\"\"Chat message with text or multimodal content; supports tool calls and tool results.\"\"\"\n     8|    role: str\n     9|    content: Optional[Union[str, List[Dict[str, Any]]]] = None\n    10|    name: Optional[str] = None\n    11|    # Assistant message with tool use\n    12|    tool_calls: Optional[List[Dict[str, Any]]] = None\n    13|    # Tool result message (role='tool')\n    14|    tool_call_id: Optional[str] = None\n    15|\n    16|\n    17|class ToolCall(BaseModel):\n    18|    \"\"\"Tool call information.\"\"\"\n    19|    id: str\n    20|    type: Literal[\"function\"] = \"function\"\n    21|    function: Dict[str, Any]\n    22|\n    23|\n    24|class ChatCompletionRequest(BaseModel):\n    25|    \"\"\"OpenAI-compatible chat completion request.\"\"\"\n    26|    model: str\n    27|    messages: List[ChatMessage]\n    28|    temperature: Optional[float] = 0.7\n    29|    top_p: Optional[float] = 0.95\n    30|    max_tokens: Optional[int] = None\n    31|    max_completion_tokens: Optional[int] = None\n    32|    stream: Optional[bool] = False\n    33|    tools: Optional[List[Dict[str, Any]]] = None\n    34|    tool_choice: Optional[Union[str, Dict[str, Any]]] = None\n    35|    response_format: Optional[Dict[str, Any]] = None\n    36|    n: Optional[int] = 1\n    37|    stop: Optional[Union[str, List[str]]] = None\n    38|    presence_penalty: Optional[float] = 0.0\n    39|    frequency_penalty: Optional[float] = 0.0\n    40|    user: Optional[str] = None\n    41|"
        }
      ]
    }
