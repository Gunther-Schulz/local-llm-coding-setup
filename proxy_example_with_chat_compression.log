          "type": "text",
          "text": "     1|\"\"\"\n     2|Central configuration for the entire system.\n     3|\n     4|All configurable settings for vLLM, proxy, and vision are defined here.\n     5|Can be overridden via environment variables.\n     6|\n     7|Configuration priority (highest to lowest):\n     8|1. Environment variables (runtime)\n     9|2. config/settings.env file (user edits)\n    10|3. Defaults in this file\n    11|\"\"\"\n    12|import os\n    13|from pathlib import Path\n    14|\n    15|\n    16|def _load_env_file():\n    17|    \"\"\"Load settings from config/settings.env if it exists.\"\"\"\n    18|    # Find project root\n    19|    current = Path(__file__).resolve()\n    20|    root_path = current.parents[1]  # Go up from stack/ to project root\n    21|    \n    22|    env_file = root_path / \"config\" / \"settings.env\"\n    23|    if not env_file.exists():\n    24|        return\n    25|    \n    26|    # Parse and load into os.environ (only if not already set)\n    27|    with open(env_file) as f:\n    28|        for line in f:\n    29|            line = line.strip()\n    30|            # Skip comments and empty lines\n    31|            if not line or line.startswith(\"#\"):\n    32|                continue\n    33|            \n    34|            # Parse KEY=VALUE\n    35|            if \"=\" in line:\n    36|                key, value = line.split(\"=\", 1)\n    37|                key = key.strip()\n    38|                value = value.strip()\n    39|                \n    40|                # Only set if not already in environment\n    41|                if key and key not in os.environ:\n    42|                    os.environ[key] = value\n    43|\n    44|\n    45|# Load config file first (before defining settings)\n    46|_load_env_file()\n    47|\n    48|\n    49|# ============================================================================\n    50|# Server Ports and URLs\n    51|# ============================================================================\n    52|\n    53|VLLM_HOST = os.getenv(\"VLLM_HOST\", \"0.0.0.0\")\n    54|VLLM_PORT = int(os.getenv(\"VLLM_PORT\", \"8000\"))\n    55|VLLM_URL = os.getenv(\"VLLM_URL\", f\"http://localhost:{VLLM_PORT}\")\n    56|\n    57|# LLM backend URL (vLLM or llama-server); proxy and clients use this\n    58|BACKEND_URL = os.getenv(\"BACKEND_URL\", f\"http://localhost:{VLLM_PORT}\")\n    59|\n    60|PROXY_HOST = os.getenv(\"PROXY_HOST\", \"0.0.0.0\")\n    61|PROXY_PORT = int(os.getenv(\"PROXY_PORT\", \"8002\"))\n    62|\n    63|VISION_HOST = os.getenv(\"VISION_HOST\", \"0.0.0.0\")\n    64|VISION_PORT = int(os.getenv(\"VISION_PORT\", \"8004\"))\n    65|VISION_URL = os.getenv(\"VISION_API_URL\", f\"http://localhost:{VISION_PORT}\")\n    66|\n    67|\n    68|# ============================================================================\n    69|# vLLM Configuration\n    70|# ============================================================================\n    71|\n    72|VLLM_DTYPE = os.getenv(\"VLLM_DTYPE\", \"float16\")\n    73|VLLM_CPU_OFFLOAD_GB = os.getenv(\"VLLM_CPU_OFFLOAD_GB\", \"8\")\n    74|VLLM_TENSOR_PARALLEL = int(os.getenv(\"VLLM_TENSOR_PARALLEL\", \"1\"))\n    75|\n    76|# CUDA graph mode: \"PIECEWISE\" (safe on 5090+AMD) or \"FULL\" (may crash)\n    77|VLLM_CUDAGRAPH_MODE = os.getenv(\"VLLM_CUDAGRAPH_MODE\", \"PIECEWISE\")\n    78|\n    79|\n    80|# ============================================================================\n    81|# Context and Token Management\n    82|# ============================================================================\n    83|\n    84|# Model context limits (set by model config, can override)\n    85|MODEL_MAX_CONTEXT = int(os.getenv(\"MODEL_MAX_CONTEXT\", \"32768\"))\n    86|MODEL_EXTENDED_CONTEXT = os.getenv(\"MODEL_EXTENDED_CONTEXT\")  # Optional extended context\n    87|\n    88|# Prompt limits\n    89|MAX_PROMPT_TOKENS = int(os.getenv(\"MAX_PROMPT_TOKENS\", \"30000\"))  # Max prompt size\n    90|SAFETY_MARGIN = int(os.getenv(\"SAFETY_MARGIN\", \"1536\"))  # Reserve for response\n    91|\n    92|\n    93|# ============================================================================\n    94|# Compression Settings (proxy feature toggles: config/settings.env \"Proxy feature toggles\")\n    95|# ============================================================================\n    96|# When 0: no tool condense, no sliding window; requests pass through until backend hits its limit (e.g. 413).\n    97|COMPRESSION_ENABLED = os.getenv(\"COMPRESSION_ENABLED\", \"1\") == \"1\"\n    98|\n    99|# Context management (Cursor-style: summarization + sliding window)\n   100|COMPRESSION_THRESHOLD = int(os.getenv(\"COMPRESSION_THRESHOLD\", \"15000\"))  # Trigger summarization when prompt tokens exceed this\n   101|COMPRESSION_TRIGGER_MESSAGES = int(os.getenv(\"COMPRESSION_TRIGGER_MESSAGES\", \"30\"))  # Or when message count exceeds this\n   102|CONTEXT_WINDOW_SIZE = int(os.getenv(\"CONTEXT_WINDOW_SIZE\", \"20\"))  # Keep this many recent messages verbatim\n   103|MAX_ARCHIVE_MESSAGES = int(os.getenv(\"MAX_ARCHIVE_MESSAGES\", \"200\"))  # Max messages to keep in archive per conversation\n   104|# Tool response condensing (messages with role=tool longer than this get preview only)\n   105|TOOL_RESPONSE_MAX_VERBATIM = int(os.getenv(\"TOOL_RESPONSE_MAX_VERBATIM\", \"2000\"))\n   106|TOOL_RESPONSE_PREVIEW_CHARS = int(os.getenv(\"TOOL_RESPONSE_PREVIEW_CHARS\", \"500\"))\n   107|# Comma-separated path patterns for which tool responses are never condensed (fnmatch).\n   108|# Set in config/settings.env; empty = condense all large tool responses.\n   109|_TOOL_NO_CONDENSE = os.getenv(\"TOOL_RESPONSE_NO_CONDENSE_PATHS\", \"\")\n   110|TOOL_RESPONSE_NO_CONDENSE_PATHS = [p.strip() for p in _TOOL_NO_CONDENSE.split(\",\") if p.strip()]\n   111|# When sliding window is active, prepend the first user message to the summary so task context is kept\n   112|PRESERVE_FIRST_USER_IN_SUMMARY = os.getenv(\"PRESERVE_FIRST_USER_IN_SUMMARY\", \"1\") == \"1\"\n   113|# When 1: only condense tool responses and trigger sliding window when prompt is near context limit\n   114|# (tokens > context_limit * 0.85). Avoids compressing when Cursor traffic would fit in 128k anyway.\n   115|COMPRESSION_ONLY_WHEN_NEAR_LIMIT = os.getenv(\"COMPRESSION_ONLY_WHEN_NEAR_LIMIT\", \"0\") == \"1\"\n   116|COMPRESSION_NEAR_LIMIT_FRACTION = float(os.getenv(\"COMPRESSION_NEAR_LIMIT_FRACTION\", \"0.85\"))\n   117|\n   118|\n   119|# ============================================================================\n   120|# Tool Calling\n   121|# ============================================================================\n   122|\n   123|# Tool parser format: \"openai\", \"qwen2.5\", \"qwen3\", \"auto\"\n   124|MODEL_TOOL_FORMAT = os.getenv(\"MODEL_TOOL_FORMAT\", \"openai\")\n   125|\n   126|\n   127|# ============================================================================\n   128|# Vision Configuration\n   129|# ============================================================================\n   130|\n   131|# Vision model paths (set by vision launcher from model config)\n   132|VISION_GGUF_PATH = os.getenv(\"VISION_GGUF_PATH\", \"\")\n   133|VISION_MMPROJ_PATH = os.getenv(\"VISION_MMPROJ_PATH\", \"\")\n   134|VISION_MAX_CONTEXT = int(os.getenv(\"VISION_MAX_CONTEXT\", \"32768\"))\n   135|\n   136|# llama.cpp binary path (use mtmd-cli - all specialized binaries are deprecated)\n   137|LLAMACPP_BIN = os.getenv(\"LLAMACPP_BIN\", \"./external/llama.cpp/build/bin/llama-mtmd-cli\")\n   138|\n   139|# llama-server for LLM engine (when LLM_ENGINE=llamacpp); CUDA build in external/llama.cpp/build-cuda\n   140|LLAMACPP_SERVER_BIN = os.getenv(\"LLAMACPP_SERVER_BIN\", \"./external/llama.cpp/build-cuda/bin/llama-server\")\n   141|\n   142|\n   143|# ============================================================================\n   144|# Debug and Logging\n   145|# ============================================================================\n   146|\n   147|DEBUG = os.getenv(\"DEBUG\", \"0\") == \"1\"\n   148|LOG_DIR = os.getenv(\"LOG_DIR\", \"logs\")\n   149|\n   150|\n   151|# ============================================================================\n   152|# Helper Functions\n   153|# ============================================================================\n   154|\n   155|def get_effective_context_limit() -> int:\n   156|    \"\"\"Get the effective context limit for the current model. Reads os.environ at call time\n   157|    so proxy/llm launchers that set MODEL_EXTENDED_CONTEXT after importing settings are respected.\"\"\"\n   158|    extended_ctx = os.getenv(\"MODEL_EXTENDED_CONTEXT\")\n   159|    if extended_ctx:\n   160|        return int(extended_ctx)\n   161|    return int(os.getenv(\"MODEL_MAX_CONTEXT\", str(MODEL_MAX_CONTEXT)))\n   162|\n   163|\n   164|def get_max_completion_tokens(prompt_tokens: int) -> int:\n   165|    \"\"\"Calculate maximum completion tokens given prompt size.\"\"\"\n   166|    ctx_limit = get_effective_context_limit()\n   167|    return max(1, ctx_limit - SAFETY_MARGIN - prompt_tokens)\n   168|\n   169|\n   170|def print_config_summary():\n   171|    \"\"\"Print current configuration (useful for debugging).\"\"\"\n   172|    print(\"=\" * 70)\n   173|    print(\"Configuration Summary\")\n   174|    print(\"=\" * 70)\n   175|    print(f\"Backend:     {BACKEND_URL}\")\n   176|    print(f\"vLLM:        {VLLM_URL}\")\n   177|    print(f\"Proxy:       {PROXY_HOST}:{PROXY_PORT}\")\n   178|    print(f\"Vision:      {VISION_URL}\")\n   179|    print(f\"Context:     {MODEL_MAX_CONTEXT} tokens\")\n   180|    print(f\"Max Prompt:  {MAX_PROMPT_TOKENS} tokens\")\n   181|    print(f\"Context Mgmt: Cursor-style (summarization + window)\")\n   182|    print(f\"  Threshold:    {COMPRESSION_THRESHOLD} tokens (or when messages > {COMPRESSION_TRIGGER_MESSAGES})\")\n   183|    print(f\"  Window Size:  {CONTEXT_WINDOW_SIZE} messages (keep recent verbatim)\")\n   184|    print(f\"  Max Archive:  {MAX_ARCHIVE_MESSAGES} messages\")\n   185|    print(f\"Debug:       {'On' if DEBUG else 'Off'}\")\n   186|    print(\"=\" * 70)\n   187|"
        }
