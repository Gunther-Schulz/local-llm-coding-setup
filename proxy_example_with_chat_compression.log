          "text": "     1|\"\"\"Streaming response handling with tool call transformation.\"\"\"\n     2|import json\n     3|import time\n     4|import uuid\n     5|from typing import Generator, Optional\n     6|\n     7|from stack.settings import DEBUG\n     8|from proxy.tool_parser import (\n     9|    parse_qwen_tool_calls,\n    10|    should_transform_tool_calls,\n    11|    generate_tool_call_chunks\n    12|)\n    13|\n    14|\n    15|class StreamState:\n    16|    \"\"\"Track state during streaming.\"\"\"\n    17|    def __init__(self, model_name: str):\n    18|        self.chunk_count = 0\n    19|        self.accumulated_content = \"\"\n    20|        self.finish_reason = None\n    21|        self.first_chunk_id = None\n    22|        self.vllm_sent_tool_calls = False\n    23|        self.tool_call_count = 0\n    24|        self.model_name = model_name\n    25|        self.created_time = int(time.time())\n    26|    \n    27|    def get_chunk_id(self) -> str:\n    28|        \"\"\"Get or generate chunk ID.\"\"\"\n    29|        return self.first_chunk_id or f\"chatcmpl-{uuid.uuid4().hex[:16]}\"\n    30|\n    31|\n    32|def process_stream_end(\n    33|    state: StreamState,\n    34|    request_id: Optional[str] = None,\n    35|    conversation_id: Optional[str] = None,\n    36|) -> Generator[str, None, None]:\n    37|    \"\"\"Process end of stream and send tool calls if needed.\"\"\"\n    38|    tool_calls = None\n    39|\n    40|    # Try to extract tool calls if we should transform\n    41|    if state.accumulated_content and should_transform_tool_calls(state.vllm_sent_tool_calls):\n    42|        tool_calls = parse_qwen_tool_calls(state.accumulated_content)\n    43|\n    44|        if DEBUG and tool_calls:\n    45|            print(f\"[DEBUG] Extracted {len(tool_calls)} tool call(s) from stream\")\n    46|\n    47|    # Send tool calls if found\n    48|    if tool_calls:\n    49|        yield from generate_tool_call_chunks(\n    50|            tool_calls, state.get_chunk_id(),\n    51|            state.model_name, state.created_time\n    52|        )\n    53|\n    54|    # Log summary\n    55|    if DEBUG:\n    56|        rid = request_id or \"n/a\"\n    57|        cid = (conversation_id[:12] + \"..\") if conversation_id and len(conversation_id) > 12 else (conversation_id or \"n/a\")\n    58|        total_tool_calls = (len(tool_calls) if tool_calls else 0) + state.tool_call_count\n    59|        print(f\"[DEBUG] ===== STREAM SUMMARY (request_id: {rid}, conversation_id: {cid}) =====\")\n    60|        print(f\"[DEBUG]   Chunks: {state.chunk_count}\")\n    61|        print(f\"[DEBUG]   Content: {len(state.accumulated_content)} chars\")\n    62|        print(f\"[DEBUG]   Tool calls: {total_tool_calls} (vLLM: {state.tool_call_count}, parsed: {len(tool_calls) if tool_calls else 0})\")\n    63|        print(f\"[DEBUG]   Finish: {state.finish_reason}\")\n    64|        print(f\"[DEBUG] ==========================\")\n    65|    \n    66|    # Always send [DONE]\n    67|    yield \"data: [DONE]\\n\\n\"\n    68|\n    69|\n    70|def stream_with_tool_transform(\n    71|    upstream,\n    72|    model_name: str,\n    73|    request_id: Optional[str] = None,\n    74|    conversation_id: Optional[str] = None,\n    75|) -> Generator[str, None, None]:\n    76|    \"\"\"\n    77|    Stream SSE events from vLLM and transform tool calls.\n    78|    \n    79|    This is the main streaming handler that:\n    80|    1. Passes through all chunks as-is\n    81|    2. Accumulates content for tool call detection\n    82|    3. At stream end, extracts and sends tool calls if needed\n    83|    \"\"\"\n    84|    state = StreamState(model_name)\n    85|    rid = request_id or \"n/a\"\n    86|    cid = (conversation_id[:12] + \"..\") if conversation_id and len(conversation_id) > 12 else (conversation_id or \"n/a\")\n    87|    _stream_start = time.perf_counter()\n    88|    completed_with_done = False  # True if we received [DONE] from backend\n    89|\n    90|    if DEBUG:\n    91|        print(f\"[DEBUG] ===== STREAMING START (request_id: {rid}, conversation_id: {cid}) =====\")\n    92|\n    93|    try:\n    94|        try:\n    95|            for chunk in upstream.iter_content(chunk_size=None):\n    96|                if not chunk:\n    97|                    continue\n    98|\n    99|                chunk_str = chunk.decode('utf-8') if isinstance(chunk, bytes) else chunk\n   100|\n   101|                for line in chunk_str.split('\\n'):\n   102|                    # Pass through non-data lines\n   103|                    if not line.strip() or not line.startswith('data: '):\n   104|                        if line.strip():\n   105|                            yield f\"{line}\\n\"\n   106|                        continue\n   107|\n   108|                    data_str = line[6:].strip()\n   109|\n   110|                    # Handle stream end\n   111|                    if data_str == \"[DONE]\":\n   112|                        completed_with_done = True\n   113|                        if DEBUG:\n   114|                            print(f\"[DEBUG] Stream received [DONE] from backend (request_id: {rid})\")\n   115|                        yield from process_stream_end(state, request_id=request_id, conversation_id=conversation_id)\n   116|                        return\n   117|\n   118|                    # Parse chunk data\n   119|                    try:\n   120|                        chunk_data = json.loads(data_str)\n   121|                        state.chunk_count += 1\n   122|\n   123|                        if not state.first_chunk_id:\n   124|                            state.first_chunk_id = chunk_data.get(\"id\")\n   125|\n   126|                        # Extract metadata\n   127|                        for choice in chunk_data.get(\"choices\", []):\n   128|                            delta = choice.get(\"delta\", {})\n   129|\n   130|                            if choice.get(\"finish_reason\"):\n   131|                                state.finish_reason = choice[\"finish_reason\"]\n   132|\n   133|                            if \"tool_calls\" in delta and delta[\"tool_calls\"]:\n   134|                                first_tool_chunk = not state.vllm_sent_tool_calls\n   135|                                state.vllm_sent_tool_calls = True\n   136|                                n_this = len(delta[\"tool_calls\"])\n   137|                                state.tool_call_count += n_this\n   138|                                if DEBUG and first_tool_chunk:\n   139|                                    print(\n   140|                                        f\"[DEBUG] tool_calls stream started (request_id: {rid}, conversation_id: {cid}) \"\n   141|                                        f\"| backend sends many small chunks; first delta has {n_this} entry(ies); \"\n   142|                                        f\"total count in STREAM SUMMARY at end\"\n   143|                                    )\n   144|\n   145|                            if \"content\" in delta and delta[\"content\"]:\n   146|                                state.accumulated_content += delta[\"content\"]\n   147|\n   148|                        # Pass through as-is\n   149|                        yield f\"{line}\\n\"\n   150|\n   151|                    except json.JSONDecodeError:\n   152|                        yield f\"{line}\\n\"\n   153|\n   154|            # Stream ended without [DONE] (backend closed connection early, or client disconnect)\n   155|            if DEBUG:\n   156|                print(f\"[DEBUG] \u26a0 Stream ended without [DONE] (request_id: {rid}, conversation_id: {cid})\")\n   157|            yield from process_stream_end(state, request_id=request_id, conversation_id=conversation_id)\n   158|\n   159|        except Exception as e:\n   160|            duration_ms = round((time.perf_counter() - _stream_start) * 1000)\n   161|            print(f\"[ERROR] Backend stream error (request_id: {rid}, conversation_id: {cid}, duration_ms: {duration_ms}): {type(e).__name__}: {e}\")\n   162|            raise\n   163|\n   164|    finally:\n   165|        duration_ms = round((time.perf_counter() - _stream_start) * 1000)\n   166|        if DEBUG:\n   167|            print(\n   168|                f\"[DEBUG] Stream generator exit (request_id: {rid}, conversation_id: {cid}, \"\n   169|                f\"completed_with_done: {completed_with_done}, duration_ms: {duration_ms}, chunks: {state.chunk_count})\"\n   170|            )\n   171|        upstream.close()\n   172|"
        }
