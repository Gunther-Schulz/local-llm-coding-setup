#!/bin/bash
# Single entry point for run/ – start servers or select config.
# Usage: ./run/run llm|proxy|vision|select model|vision
set -e

RUN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${ROOT:-${WORKSPACE:-${RUNPOD_ROOT:-$(cd "$RUN_DIR/.." && pwd)}}}"
export ROOT
. "$ROOT/lib/activate.sh"
cd "$ROOT"
export PYTHONPATH="${ROOT}:${PYTHONPATH:-}"

cmd="${1:-}"
shift || true

case "$cmd" in
  llm)    exec python -m run.llm "$@" ;;
  proxy)  exec python -m run.proxy "$@" ;;
  vision) exec python -m run.vision "$@" ;;
  select)
    sub="${1:-}"
    shift || true
    case "$sub" in
      model)  exec python -m run.select_model "$@" ;;
      vision) exec python -m run.select_vision_model "$@" ;;
      *)      echo "Usage: ./run/run select model|vision [args...]" >&2; exit 1 ;;
    esac ;;
  "")
    echo "Usage: ./run/run llm|proxy|vision|select model|vision [args...]" >&2
    echo "  llm     – start LLM backend (llama-server)" >&2
    echo "  proxy   – start compression proxy" >&2
    echo "  vision  – start vision API" >&2
    echo "  select  – select model | vision" >&2
    exit 1 ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Usage: ./run/run llm|proxy|vision|select model|vision" >&2
    exit 1 ;;
esac
