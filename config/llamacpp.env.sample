# Sample configuration for llama-server (llama.cpp) – copy to config/llamacpp.env and edit.
# config/llamacpp.env is gitignored. Only the launcher (./run/run llm) reads this.
#   cp config/llamacpp.env.sample config/llamacpp.env
#
# This file is for BACKEND (llama-server) only. Proxy settings live in config/settings.env.
# Per-model overrides: optional llama: section in config/models/<key>.yaml (fit_context, cache_type_k, moe_offload).

# ============================================================================
# Context and fit
# ============================================================================
# FIT_CONTEXT=1     When 1: pass --fit on so llama.cpp picks max context that fits. When 0: use -c from model/extended.
# Per-model override: llama.fit_context in config/models/<key>.yaml (1/0/-).
FIT_CONTEXT=0

# ============================================================================
# KV cache (context quantization) – fit longer context / free VRAM
# ============================================================================
# Cache type for K: f16 (default), f32, bf16, q8_0, q4_0, q4_1, iq4_nl, q5_0, q5_1. Empty = use llama default.
# Per-model override: llama.cache_type_k in config/models/<key>.yaml.
# CACHE_TYPE_K=q4_1

# ============================================================================
# MoE offload – when model does not fit in VRAM, offload experts to CPU
# ============================================================================
# Regex for layers to offload to CPU (e.g. ".ffn_.*_exps.=CPU" for all MoE experts). Empty = no offload.
# Per-model override: llama.moe_offload in config/models/<key>.yaml ("moe" = full MoE offload, empty = none).
# MOE_OFFLOAD_REGEX=

# ============================================================================
# Sampling defaults (Qwen/Unsloth recommended for Qwen3-Coder-Next)
# ============================================================================
# Passed to llama-server when set. Per-model override: temp, top_p, top_k, min_p in config/models/<key>.yaml.
# LLAMACPP_TEMP=1.0
# LLAMACPP_TOP_P=0.95
# LLAMACPP_TOP_K=40
# LLAMACPP_MIN_P=0.01
# LLAMACPP_SEED=3407
