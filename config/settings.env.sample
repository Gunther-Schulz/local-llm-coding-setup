# Sample configuration – copy to config/settings.env and edit.
# config/settings.env is gitignored; this sample is committed as a template.
#   cp config/settings.env.sample config/settings.env

# Central Configuration File
# All settings for Proxy, Vision, and llama-server backend
# Edit this file and restart services to apply changes

# ============================================================================
# Usage: When you need the proxy vs going direct to llama-server
# ============================================================================
# Llama-server (recent llama.cpp) can handle chat and native tool_calls by
# itself. You only NEED this proxy if you want:
#   • Compression / sliding window when context would overflow (summarize old,
#     keep last N; otherwise backend would 413 or OOM).
#   • Virtual tool: search_compressed_conversation (query full pre-compression
#     history; only exists in proxy memory).
#   • System message injection: config/system_message.txt (and optionally
#     config/capability_reminder.txt appended when tools are present – reminds
#     the model it has full conversation and tools, reduces "I can't recall" /
#     "I can't search" / "I'll just advise").
# If you skip the proxy and point the client straight at llama-server, you get
# chat + tool_calls only; no compression, no virtual tool, no injection.
#
# When you USE this proxy, the only difference is which backend it forwards to:
#   Cursor Cloud: Client → this proxy → Cursor's cloud API. BACKEND_URL = Cursor.
#   Standalone:   Client → this proxy → your local LLM. BACKEND_URL = localhost:8000.
# Active preset: Cursor Cloud. For Standalone, set BACKEND_URL and run ./run/run llm.

# ============================================================================
# Server Ports
# ============================================================================
# Proxy listens on PROXY_PORT; backend (Cursor Cloud or local llama-server) on VLLM_PORT or external URL.
VLLM_PORT=8000
PROXY_PORT=8002
VISION_PORT=8004

# ============================================================================
# Context Mode (single switch – llama-server and proxy both read this)
# ============================================================================
# For Standalone (local LLM); when backend is Cursor Cloud, proxy still uses this for limits.
# normal   = base context (32K), fast
# extended = extended context (128K from models.conf)
CONTEXT_MODE=extended

# ============================================================================
# Context Limits (aligned with CONTEXT_MODE and models.conf)
# ============================================================================
# Base context when CONTEXT_MODE=normal. Extended limit comes from models.conf
# (extended_context, e.g. 131072) and is used when CONTEXT_MODE=extended.
# Proxy uses 128K when CONTEXT_MODE=extended (from model or MODEL_EXTENDED_CONTEXT_DEFAULT).
MODEL_MAX_CONTEXT=32768
# MODEL_EXTENDED_CONTEXT_DEFAULT=131072

# Max prompt size before compression/rejection
# Align with effective context: ~(effective - SAFETY_MARGIN)
MAX_PROMPT_TOKENS=125000

SAFETY_MARGIN=2048

# ============================================================================
# Proxy feature toggles (1=on, 0=off unless noted)
# ============================================================================
# Standalone only: these apply when the proxy is in the path. Restart proxy
# (./run/run proxy) after changes. Cursor Cloud: not used.
#
# COMPRESSION_ENABLED=0      When 0: no tool condense, no sliding window; pass-through until backend hits its limit (e.g. 413). YaRN/extended context unchanged.
# DEBUG=1                    Verbose proxy logs. 0=quiet.
# PRESERVE_FIRST_USER_IN_SUMMARY=1   When sliding window runs, prepend first user message. (Only when COMPRESSION_ENABLED=1.)
# COMPRESSION_ONLY_WHEN_NEAR_LIMIT=1 When 1: only condense + slide when tokens near limit.
# INJECT_CAPABILITY_REMINDER=1       When 1: append config/capability_reminder.txt to system message (when tools present) so model uses context and tools instead of claiming it can't recall or search. 0=off.
#
# Paths that never get condensed (comma-separated, fnmatch). Empty = condense when near limit like everything else.
TOOL_RESPONSE_NO_CONDENSE_PATHS=
#
COMPRESSION_ENABLED=0
DEBUG=1
PRESERVE_FIRST_USER_IN_SUMMARY=1
COMPRESSION_ONLY_WHEN_NEAR_LIMIT=1
COMPRESSION_NEAR_LIMIT_FRACTION=0.85

# ============================================================================
# How sliding window works (when we DO compress)
# ============================================================================
# We do NOT send full context to the model. When sliding window runs:
#   - OLD messages are summarized into ONE short user message (2–3 paragraphs from the LLM).
#   - LAST CONTEXT_WINDOW_SIZE messages are kept verbatim (after tool condense for non–no-condense paths).
#   - Full original text of old messages is archived in proxy memory only (not sent to backend).
# So the model sees: [system?] [summary of old + optional first user request] [last N messages].
# With COMPRESSION_ONLY_WHEN_NEAR_LIMIT=1 we only run this when tokens > COMPRESSION_THRESHOLD.

# ============================================================================
# Context Management (thresholds and sizes)
# ============================================================================
# When to compress (with COMPRESSION_ONLY_WHEN_NEAR_LIMIT=1: only when tokens > COMPRESSION_THRESHOLD).
# Otherwise: when prompt_tokens > COMPRESSION_THRESHOLD OR message count > COMPRESSION_TRIGGER_MESSAGES.
# What we keep verbatim: last CONTEXT_WINDOW_SIZE messages (older ones summarized).
# Tool responses: condensed when length > TOOL_RESPONSE_MAX_VERBATIM (unless path in NO_CONDENSE or near_limit and under threshold).
COMPRESSION_THRESHOLD=100000
COMPRESSION_TRIGGER_MESSAGES=50
CONTEXT_WINDOW_SIZE=40
MAX_ARCHIVE_MESSAGES=200
TOOL_RESPONSE_MAX_VERBATIM=2000
TOOL_RESPONSE_PREVIEW_CHARS=500
# Paths never condensed (see TOOL_RESPONSE_NO_CONDENSE_PATHS in Proxy feature toggles above).

# ============================================================================
# Debug
# ============================================================================
# Proxy debug logging: set DEBUG=1 in "Proxy feature toggles" above, restart proxy.
# When DEBUG=1 you get [DEBUG] Full request, context stats, tool condense/sliding_window lines.

# ============================================================================
# Virtual tool (search_compressed_conversation)
# ============================================================================
# When COMPRESSION_ENABLED=1 we store full history and expose search_compressed_conversation.
# Applies whenever you use this proxy (Cursor Cloud or Standalone backend).
# Max compressed conversations in memory. 0 = unlimited (full history).
COMPRESSED_STORE_MAX_CONVERSATIONS=10
# Caps on virtual tool results (0 = no cap). Sane defaults to avoid blowing context.
COMPRESSED_STORE_RESULT_MAX_CHARS=4000
COMPRESSED_STORE_SEARCH_TOP_K=5
COMPRESSED_STORE_SEARCH_MAX_CHARS=3500

# ============================================================================
# Alignment (all from this file)
# ============================================================================
# CONTEXT_MODE       → llama-server context, proxy (effective limit). One place.
# MODEL_MAX_CONTEXT  → base 32K; extended limit from models.conf per model.
# When CONTEXT_MODE=normal:    lower COMPRESSION_THRESHOLD (e.g. 20000), CONTEXT_WINDOW_SIZE (e.g. 25)
# When CONTEXT_MODE=extended:  current values (100K threshold, 40 msgs verbatim, trigger at 50 msgs)
# Restart proxy after changing context/compression limits.
