# ACTIVE_MODEL = which model to load.
# Rule: ACTIVE_MODEL value MUST equal the YAML filename (without .yaml).
#   Example: ACTIVE_MODEL=qwen3-coder-next-mxfp4  →  loads config/models/qwen3-coder-next-mxfp4.yaml
#            and weights from models/qwen3-coder-next-mxfp4/
# Use this SAME value in Cursor as the model name (one name everywhere).
ACTIVE_MODEL=qwen3-coder-next-mxfp4

# Server. Override: ./run_server.sh [MODEL_KEY] [PORT] — model only keeps PORT from here.
PORT=8000
HOST=127.0.0.1
