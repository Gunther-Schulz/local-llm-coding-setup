# =============================================================================
# Four modes, set independently. Only one mode active at a time.
# All modes: LLM(s) + proxy (client points at proxy).
# Proxy backend is always the CHAT/completions server on 8001 (refactor: wire proxy to 8001).
# Backend (llama vs vLLM) is per-model: set in config/models/<key>.yaml (backend: llama | vllm).
# =============================================================================
HOST=127.0.0.1

# Conda env for vLLM backend (when model YAML has backend: vllm). Default: vLLM.
# VLLM_CONDA_ENV=vLLM

# llama-server CPU threads (--threads). If set, overrides per-model config/models/*.yaml threads.
# Unset = use value from each model's YAML (e.g. 28).
LLAMA_THREADS=24

# Model alias for /v1/models (use this name in Cursor). One name for all local models; Cursor stays set to this.
# Unset = "local". Set to match Cursor (e.g. CURSOR_MODEL_ALIAS=runpod).
# CURSOR_MODEL_ALIAS=local

# Server log: keep only last N lines (avoids huge logs with --verbose). Unset = no limit.
SERVER_LOG_TAIL_LINES=50000

# ---------- Mode 1: Pure chat (one LLM + proxy)
PURE_CHAT_MODEL=glm-4.7-flash-ud-q6-k-xl
PURE_CHAT_PORT=8001
# PURE_CHAT_PROXY_PORT=8010

# ---------- Mode 2: Coding (one LLM + proxy; Cursor points at proxy)
CODING_MODEL=qwen3-coder-next-mxfp4
CODING_PORT=8001
CODING_PROXY_PORT=8010
# Stop tool-call loop after same call repeated N times (proxy injects stop, tool_choice=none)
# CODING_PROXY_MAX_IDENTICAL_TOOL_CALLS=3
# Stop re-reading same file / same Grep pattern after N rounds (proxy injects stop, tool_choice=none)
# CODING_PROXY_MAX_SIMILAR_TOOL_CALLS=4

# ---------- Mode 3: Notebook LM (router mode: embedding + chat on one port)
EMBEDDING_MODEL=bge-m3
NOTEBOOK_CHAT_MODEL=qwen3-next-80b-abliterated-mxfp4
NOTEBOOK_CHAT_PORT=8001
# NOTEBOOK_PROXY_PORT=8010

# ---------- Mode 4: Code + Vision (coding model + pure vision model; like Mode 3 has chat + embedding)
# Vision: image → text only. Coding: chat/tools. Use both when Cursor sends chat + image.
CODE_VISION_VISION_MODEL=qwen2.5-vl-7b-instruct
CODE_VISION_VISION_PORT=8002
CODE_VISION_CODING_MODEL=glm-4.7-flash-ud-q6-k-xl
CODE_VISION_CODING_PORT=8001
# CODE_VISION_PROXY_PORT=8010
