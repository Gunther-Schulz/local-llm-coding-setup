# =============================================================================
# Four modes, set independently. Only one mode active at a time.
# All modes: LLM(s) + proxy (client points at proxy).
# Proxy backend is always the CHAT/completions server on 8001 (refactor: wire proxy to 8001).
# =============================================================================
HOST=127.0.0.1

# ---------- Mode 1: Pure chat (one LLM + proxy)
PURE_CHAT_MODEL=qwen3-next-80b-abliterated-mxfp4
PURE_CHAT_PORT=8001
# PURE_CHAT_PROXY_PORT=8010

# ---------- Mode 2: Coding (one LLM + proxy; Cursor points at proxy)
CODING_MODEL=qwen3-coder-next-mxfp4
CODING_PORT=8001
CODING_PROXY_PORT=8010

# ---------- Mode 3: Notebook LM (router mode: embedding + chat on one port)
EMBEDDING_MODEL=bge-m3
NOTEBOOK_CHAT_MODEL=qwen3-next-80b-abliterated-mxfp4
NOTEBOOK_CHAT_PORT=8001
# NOTEBOOK_PROXY_PORT=8010

# ---------- Mode 4: Code + Vision (coding model + pure vision model; like Mode 3 has chat + embedding)
# Vision: image → text only. Coding: chat/tools. Use both when Cursor sends chat + image.
CODE_VISION_VISION_MODEL=qwen2.5-vl-7b-instruct
CODE_VISION_VISION_PORT=8002
CODE_VISION_CODING_MODEL=qwen3-coder-next-mxfp4
CODE_VISION_CODING_PORT=8001
# CODE_VISION_PROXY_PORT=8010
