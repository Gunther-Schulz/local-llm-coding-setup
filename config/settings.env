# Central Configuration File
# All settings for vLLM, Proxy, and Vision servers
# Edit this file and restart services to apply changes

# ============================================================================
# Server Ports
# ============================================================================
VLLM_PORT=8000
PROXY_PORT=8002
VISION_PORT=8004

# ============================================================================
# Context Management
# ============================================================================
# Maximum prompt size before compression/rejection
MAX_PROMPT_TOKENS=30000

# Safety margin reserved for completion
SAFETY_MARGIN=1536

# ============================================================================
# Compression Settings (for very long conversations)
# ============================================================================
# Enable compression (1=on, 0=off)
COMPRESSION_ENABLED=1

# Trigger compression when conversation exceeds this many tokens
COMPRESSION_THRESHOLD=20000

# How many recent messages to keep uncompressed (1-4 recommended)
# Lower = more compression = longer conversations possible
# Higher = better context quality = shorter max conversation
KEEP_RECENT_MESSAGES=2

# Compression rate: 0.33 = keep 33% of tokens (0.2-0.5 recommended)
COMPRESSION_RATE=0.33

# ============================================================================
# vLLM Settings
# ============================================================================
VLLM_DTYPE=float16
VLLM_CPU_OFFLOAD_GB=8

# CUDAGRAPH MODE: PIECEWISE (safe) or FULL (may crash on 5090+AMD)
VLLM_CUDAGRAPH_MODE=PIECEWISE

# ============================================================================
# Debug
# ============================================================================
# Enable debug logging (1=on, 0=off)
DEBUG=0

# ============================================================================
# Notes
# ============================================================================
# - Restart services after changing settings
# - KEEP_RECENT_MESSAGES: Lower for unlimited conversations, higher for quality
# - MAX_PROMPT_TOKENS: Near model max (32K), leave room for response
# - COMPRESSION_THRESHOLD: Start compressing at 20K tokens
