# Central Configuration File
# All settings for vLLM, Proxy, and Vision servers
# Edit this file and restart services to apply changes

# ============================================================================
# Server Ports
# ============================================================================
VLLM_PORT=8000
PROXY_PORT=8002
VISION_PORT=8004

# ============================================================================
# Context Mode (single switch – vLLM and proxy both read this)
# ============================================================================
# normal   = base context (32K), fast
# extended = YaRN extended context (128K from models.conf), ~50–70% slower
# No need to set EXTENDED_CONTEXT_MODE=1 when running vllm.sh – this file controls it.
CONTEXT_MODE=extended

# ============================================================================
# Context Limits (aligned with CONTEXT_MODE and models.conf)
# ============================================================================
# Base context when CONTEXT_MODE=normal. Extended limit comes from models.conf
# (extended_context, e.g. 131072) and is used when CONTEXT_MODE=extended.
MODEL_MAX_CONTEXT=32768

# Max prompt size before compression/rejection
# Align with effective context: ~(effective - SAFETY_MARGIN)
MAX_PROMPT_TOKENS=125000

SAFETY_MARGIN=2048

# ============================================================================
# Context Management (Cursor-style summarization)
# ============================================================================
# Trigger summarization when conversation exceeds this many tokens
COMPRESSION_THRESHOLD=80000

CONTEXT_WINDOW_SIZE=25
MAX_ARCHIVE_MESSAGES=200

# ============================================================================
# vLLM Settings
# ============================================================================
VLLM_DTYPE=float16
VLLM_CPU_OFFLOAD_GB=8

# CUDAGRAPH MODE: FULL (default) or PIECEWISE (use if FULL crashes on 5090+AMD)
VLLM_CUDAGRAPH_MODE=FULL

# ============================================================================
# Debug
# ============================================================================
# Enable debug logging (1=on, 0=off)
DEBUG=0

# ============================================================================
# Alignment (all from this file)
# ============================================================================
# CONTEXT_MODE       → vLLM (YaRN on/off), proxy (effective limit). One place.
# MODEL_MAX_CONTEXT  → base 32K; extended limit from models.conf per model.
# When CONTEXT_MODE=normal:    use MAX_PROMPT_TOKENS=30000, COMPRESSION_THRESHOLD=20000
# When CONTEXT_MODE=extended:  use MAX_PROMPT_TOKENS=125000, COMPRESSION_THRESHOLD=80000
# Restart vLLM and proxy after changing CONTEXT_MODE or context limits.
