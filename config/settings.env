# Central Configuration File
# All settings for vLLM, Proxy, and Vision servers
# Edit this file and restart services to apply changes

# ============================================================================
# Server Ports
# ============================================================================
VLLM_PORT=8000
PROXY_PORT=8002
VISION_PORT=8004

# ============================================================================
# Context Mode (single switch – vLLM and proxy both read this)
# ============================================================================
# normal   = base context (32K), fast
# extended = YaRN extended context (128K from models.conf), ~50–70% slower
# No need to set EXTENDED_CONTEXT_MODE=1 when running vllm.sh – this file controls it.
CONTEXT_MODE=extended

# ============================================================================
# Context Limits (aligned with CONTEXT_MODE and models.conf)
# ============================================================================
# Base context when CONTEXT_MODE=normal. Extended limit comes from models.conf
# (extended_context, e.g. 131072) and is used when CONTEXT_MODE=extended.
# Proxy uses 128K when CONTEXT_MODE=extended (from model or MODEL_EXTENDED_CONTEXT_DEFAULT).
MODEL_MAX_CONTEXT=32768
# MODEL_EXTENDED_CONTEXT_DEFAULT=131072

# Max prompt size before compression/rejection
# Align with effective context: ~(effective - SAFETY_MARGIN)
MAX_PROMPT_TOKENS=125000

SAFETY_MARGIN=2048

# ============================================================================
# Context Management (summarization + sliding window; tool results condensed to preview)
# ============================================================================
# When to compress: summarization runs when EITHER condition is true:
#   - prompt_tokens > COMPRESSION_THRESHOLD
#   - message count > COMPRESSION_TRIGGER_MESSAGES
# What we keep verbatim: last CONTEXT_WINDOW_SIZE messages (older ones summarized).
# Tool responses: condensed on every request (preview only if > TOOL_RESPONSE_MAX_VERBATIM).
# Tuned for extended context (128K); use lower values for normal (32K).
COMPRESSION_THRESHOLD=100000
COMPRESSION_TRIGGER_MESSAGES=50
CONTEXT_WINDOW_SIZE=40
MAX_ARCHIVE_MESSAGES=200
TOOL_RESPONSE_MAX_VERBATIM=2000
TOOL_RESPONSE_PREVIEW_CHARS=500

# ============================================================================
# LLM Engine (vllm | llamacpp)
# ============================================================================
# Which backend to run: vllm or llamacpp (llama-server).
# Override: LLM_ENGINE=vllm ./run/run llm   or use ./run/run select engine vllm
# Both backends listen on VLLM_PORT (8000); proxy uses BACKEND_URL (same).
LLM_ENGINE=llamacpp

# ============================================================================
# vLLM Settings
# ============================================================================
VLLM_DTYPE=float16
VLLM_CPU_OFFLOAD_GB=8

# CUDAGRAPH MODE: FULL (default) or PIECEWISE (use if FULL crashes on 5090+AMD)
VLLM_CUDAGRAPH_MODE=FULL

# ============================================================================
# Debug
# ============================================================================
# Enable debug logging (1=on, 0=off). Use when investigating tool-call issues:
# set DEBUG=1, restart proxy (./run/run proxy), then check proxy stdout for
# [DEBUG] Full request, [DEBUG] Response, [DEBUG] Extracted N tool call(s).
DEBUG=1

# ============================================================================
# Alignment (all from this file)
# ============================================================================
# CONTEXT_MODE       → vLLM (YaRN on/off), proxy (effective limit). One place.
# MODEL_MAX_CONTEXT  → base 32K; extended limit from models.conf per model.
# When CONTEXT_MODE=normal:    lower COMPRESSION_THRESHOLD (e.g. 20000), CONTEXT_WINDOW_SIZE (e.g. 25)
# When CONTEXT_MODE=extended:  current values (100K threshold, 40 msgs verbatim, trigger at 50 msgs)
# Restart proxy after changing context/compression limits.
