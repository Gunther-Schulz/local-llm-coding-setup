# Qwen3-Coder-Next 80B MXFP4_MOE – models/qwen3-coder-next-mxfp4/
GGUF=Qwen3-Coder-Next-MXFP4_MOE.gguf
CONTEXT_SIZE=262144
# -1 = all layers on GPU; set lower for partial CPU offload
N_GPU_LAYERS=-1
# Required for tool/function calling (chat template)
JINJA=1
# Qwen/Unsloth recommended for Qwen3-Coder-Next
TEMP=1.0
TOP_P=0.95
TOP_K=40
MIN_P=0.01
SEED=3407
# 4096 triples prompt processing; offloading a layer or two to RAM hurts less than prefill gain
BATCH_SIZE=4096
UBATCH_SIZE=4096
