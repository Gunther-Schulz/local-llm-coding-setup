# Local wheel cache (download once, reuse across -r)
.wheels/

# Runtime config (machine-specific)
config/llm-config
config/config.conf
config/settings.env
config/llamacpp.env

# Logs
logs/

# Test directories
.test_wheel/

# Model weights (downloaded GGUF); config/models/ is tracked
/models/
# External dependencies (llama.cpp, built locally)
external/

# Benchmark run results (overwritten each run)
benchmark/next/results.txt
benchmark/next/.server_log.txt

# Obsolete: llama.cpp clone used to live here; now in external/llama.cpp
benchmark/llama.cpp/

# Python cache
__pycache__/
*.pyc
*.pyo
vllm/
baseurl.txt
